* text=auto

# Code and text
*.cs      text diff=csharp
*.shader  text
*.hlsl    text
*.json    text
*.md      text
*.asmdef  text

# Unity YAML: force LF and never auto-merge line by line
*.unity   text eol=lf merge=unityyamlmerge
*.prefab  text eol=lf merge=unityyamlmerge
*.asset   text eol=lf merge=unityyamlmerge
*.mat     text eol=lf merge=unityyamlmerge
*.anim    text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.meta    text eol=lf merge=unityyamlmerge

# Binary media in normal Git (GitHub LFS free quota exceeded for this account).
# Re-enable LFS later if the budget is increased; files are small enough for regular blobs.
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.tif  binary
*.exr  binary
*.hdr  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.mov  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.ttf  binary
*.otf  binary
